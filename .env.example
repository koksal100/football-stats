# Bu dosyayı .env olarak kopyalayın ve değerleri değiştirin.
# .env dosyası .gitignore ile hariç tutulur.

# --- PostgreSQL (local geliştirme) ---
DB_URL=jdbc:postgresql://localhost:5432/football
DB_USERNAME=football
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-characters

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080
